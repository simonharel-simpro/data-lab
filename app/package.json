{
  "name": "data-lab-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-security": "4.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@isaacs/nonrecursive-glob-match": "1.0.1",
    "@eslint-community/regexpp": "4.12.2",
    "globals": "17.13.0",
    "postcss-selector-parser": "7.1.7",
    "@typescript-eslint/scope-manager": "8.72.0",
    "@typescript-eslint/types": "8.72.0",
    "@typescript-eslint/visitor-keys": "8.72.0"
  }
}
