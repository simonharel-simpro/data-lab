# Weaviate host (shared data-lab stack, bound to 127.0.0.1 only)
DATALAB_WEAVIATE_HOST=127.0.0.1
# Weaviate REST port (not 8080: that is Demo-RAG's)
DATALAB_WEAVIATE_HTTP_PORT=8090
# Weaviate gRPC port (not 50051: that is Demo-RAG's; a wrong value splits REST and gRPC across stacks, F-4)
DATALAB_WEAVIATE_GRPC_PORT=50052
# MLflow tracking server (not 5000: that is Demo-RAG's)
DATALAB_MLFLOW_TRACKING_URI=http://127.0.0.1:5050
# LLM over the Anthropic Messages API. Default: OpenRouter (https://openrouter.ai/settings/keys).
# Required, no default: set the key in .env (gitignored).
MINI_RAG_LLM_API_KEY=
# Defaults: MINI_RAG_LLM_BASE_URL=https://openrouter.ai/api, MINI_RAG_GEN_MODEL=deepseek/deepseek-v4-flash
# To use the LAN DGX instead (it ignores the key, but one must be set):
#   MINI_RAG_LLM_BASE_URL=http://<dgx-host>:8000
#   MINI_RAG_GEN_MODEL=deepseek-v4-flash
#   MINI_RAG_LLM_API_KEY=unused
