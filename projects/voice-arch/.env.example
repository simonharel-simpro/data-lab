# Weaviate host (shared data-lab stack, bound to 127.0.0.1 only)
DATALAB_WEAVIATE_HOST=127.0.0.1
# Weaviate REST port (not 8080: that is Demo-RAG's)
DATALAB_WEAVIATE_HTTP_PORT=8090
# Weaviate gRPC port (not 50051: that is Demo-RAG's; a wrong value splits REST and gRPC across stacks, F-4)
DATALAB_WEAVIATE_GRPC_PORT=50052
# MLflow tracking server (not 5000: that is Demo-RAG's)
DATALAB_MLFLOW_TRACKING_URI=http://127.0.0.1:5050
# OpenRouter key: optional here. When blank, the repo-root OPENROUTER_API_KEY is used.
VOICE_ARCH_OPENROUTER_API_KEY=
# LiveKit keys = the root LIVEKIT_API_KEY / LIVEKIT_API_SECRET (the secret must be at least 32 characters).
VOICE_ARCH_LIVEKIT_API_KEY=
VOICE_ARCH_LIVEKIT_API_SECRET=
# The experiment budget is enforced in software: VOICE_ARCH_EXPERIMENT_BUDGET_USD (default 50).
# Do not use the OpenRouter key elsewhere during a sweep: the cost of a run is the key's usage delta.
