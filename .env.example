# Weaviate host (shared data-lab stack, bound to 127.0.0.1 only)
DATALAB_WEAVIATE_HOST=127.0.0.1
# Weaviate REST port (not 8080: that is Demo-RAG's)
DATALAB_WEAVIATE_HTTP_PORT=8090
# Weaviate gRPC port (not 50051: that is Demo-RAG's; a wrong value splits REST and gRPC across stacks, F-4)
DATALAB_WEAVIATE_GRPC_PORT=50052
# MLflow tracking server (not 5000: that is Demo-RAG's)
DATALAB_MLFLOW_TRACKING_URI=http://127.0.0.1:5050
# OpenRouter key for the Weavit web RAG preset (tools/weavit-web.sh); optional, keep it in .env (gitignored)
OPENROUTER_API_KEY=
